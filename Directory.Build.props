<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Authors>WinTuner contributors</Authors>
    <Product>WinTuner</Product>
    <Description>Declarative, rollback-safe Windows update &amp; service tuning toolkit.</Description>
    <RepositoryUrl>https://github.com/yourname/wintuner</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
