<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>WinTuner.Core.Tests</RootNamespace>
    <AssemblyName>WinTuner.Core.Tests</AssemblyName>
    <!-- Needed so GlobalizationTests can exercise the same WPF language lookup
         that runs when the GUI creates its main window. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinTuner.Core\WinTuner.Core.csproj" />
  </ItemGroup>

</Project>
